#compdef smf ./smf

# Zsh completion for the SMF CLI. The explicit compdef at the end also makes
# `source completions/_smf` work after compinit has run.

_smf() {
  if [[ "${words[CURRENT]}" == "-" ]]; then
    return 1
  fi

  if (( CURRENT == 2 )); then
    _values 'smf command or option' \
      'install[Plan and install SMF through Ansible]' \
      'list[Show the local SMF Compose service state]' \
      '--help[Show usage]' \
      '--version[Show the smf version]'
    return
  fi

  case "${words[2]}" in
    install)
      _arguments \
        '(--network-only)--port=[Publish PORT on the host as PORT:80]:host port:' \
        '(--port)--network-only[Keep SMF on Docker networks only]' \
        '--apply[Apply the installation plan without final confirmation]' \
        '--disable-installer[Disable SMF web installer during deployment]' \
        '--project-dir=[Repository containing the SMF playbooks]:directory:_directories' \
        '--inventory=[Inventory file, relative to the project by default]:inventory file:_files' \
        '--target=[Override TARGET_HOSTS for the playbooks]:hosts expression:' \
        '(--no-ask-become-pass)--ask-become-pass[Always ask Ansible for the sudo password]' \
        '(--ask-become-pass)--no-ask-become-pass[Never ask Ansible for the sudo password]' \
        '(--no-ask-vault-pass --vault-password-file)--ask-vault-pass[Always ask for an Ansible Vault password]' \
        '(--ask-vault-pass)--no-ask-vault-pass[Never ask for an Ansible Vault password]' \
        '(--ask-vault-pass)--vault-password-file=[Use an Ansible Vault password file]:password file:_files' \
        '--ansible-playbook=[Use this ansible-playbook executable]:executable:_command_names -e' \
        '--ansible-runtime=[Store the managed private Ansible environment here]:directory:_directories' \
        '--no-bootstrap-ansible[Do not install ansible-core if it is unavailable]' \
        '--non-interactive[Do not ask exposure or confirmation questions]' \
        '--help[Show usage]'
      ;;
    list)
      _arguments \
        '--deployment-dir=[Local SMF Compose deployment directory]:directory:_directories' \
        '--help[Show usage]'
      ;;
  esac
}

if (( $+functions[compdef] )); then
  compdef _smf smf ./smf
fi
